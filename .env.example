# Copy this file to .env and fill in your ServiceTitan credentials.
# Generate these from https://developer.servicetitan.io after creating an integration app.

ST_APP_KEY=your-app-key-here
ST_TENANT_ID=your-tenant-id-here
ST_CLIENT_ID=your-client-id-here
ST_CLIENT_SECRET=your-client-secret-here

# Set to "integration" to hit the ServiceTitan integration environment instead of production.
ST_ENVIRONMENT=production

# Postgres cache (Neon recommended for cloud, neon.tech free tier).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

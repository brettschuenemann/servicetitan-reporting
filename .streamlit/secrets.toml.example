# Template for Streamlit Cloud secrets. In Streamlit Cloud, open your app's
# settings → Secrets and paste the contents below (with real values).
# DO NOT commit secrets.toml itself — it's gitignored.

# Shared password for the team. Pick something strong; everyone uses the same one.
app_password = "change-me-please"

# Postgres cache. Get a free one from neon.tech (recommended).
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL = "postgresql://..."

# ServiceTitan integration credentials.
ST_APP_KEY      = "your-app-key"
ST_TENANT_ID    = "your-tenant-id"
ST_CLIENT_ID    = "your-client-id"
ST_CLIENT_SECRET = "your-client-secret"
ST_ENVIRONMENT  = "production"   # or "integration"
